* {
  margin: 0;
  padding: 0;
  box-sizing: border-box; /* Add this too! */
}

body {
  background-color: black;
}
.main {
  background-image: url(assets/pictures/background.jpg);
  height: 100vh;
  position: relative;
}

nav {
  position: relative;
  z-index: 2; /* This puts the entire nav above the overlay */
}

main .box {
  top: 0;
  opacity: 0.44;
  background-color: black;
}

nav .Netflix {
  color: rgb(255, 14, 14);
  font-size: 25px;
  padding: 10px 0 0 50px;
  display: flex;
}

.main .overlay {
  background-color: rgba(0, 0, 0, 0.8);
  z-index: 1;
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

nav .line {
  color: white;
  position: relative;
  font-weight: bold;
  font-size: x-large;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 2px;
  padding-top: 200px;
}

nav .line h5 {
  padding-top: 5px;
  font-weight: normal;
}

nav .LINE h5 {
  padding-top: 30px;
  font-weight: normal;
  color: white;
  padding-left: 400px;
  font-size: 125%;
}

nav .INPUT {
  padding-left: 404px;
  padding-top: 20px;
}

nav .INPUT input {
  height: 63px;
  width: 360px;
  border: 2px solid rgb(95, 92, 92);
  background-color: rgba(63, 63, 63, 0.5);
  padding-left: 15px;
  padding-right: 15px;
  font-size: 19px;
  border-radius: 4px;
}

nav .INPUT input::placeholder {
  color: rgba(255, 255, 255, 0.7);
}

nav .BUTTON {
  position: relative;
}

nav .BUTTON button {
  color: white;
  background-color: rgb(238, 15, 15);
  height: 67px;
  width: 193px;
  position: absolute;
  top: -65px;
  left: 780px;
  cursor: pointer;
  border-radius: 4px;
  font-size: 20px;
  padding-right: 70px;
  padding-left: 30px;
  white-space: nowrap;
}

button::after {
  content: ">";
  font-size: 24px; /* Make it larger */
}
