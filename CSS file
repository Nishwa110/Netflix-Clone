*{
    padding: 0px;
    margin: 0;
}
.main{
    background-image: url(assets/pictures/background.jpg);
    height: 100vh;
    position: relative;

}
main .box{
    top:0;
    opacity:0.44;
    background-color: black;
 
}

nav h1:first-child {
    color: red;
    font-size: 50px;
    padding: 10px 0 0 50px;
}

.main .overlay{
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;

}

nav {
    color: white;
    position: relative; 
    font-weight: bold;
    font-size: larger;
    z-index: 2;
    display: flex;
    justify-self: right;
}
