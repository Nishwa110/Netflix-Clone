*{
    padding: 0px;
    margin: 0;
}
.main{
    background-image: url(assets/pictures/background.jpg);
    height: 100vh;
    position: relative;

}

nav {
    position: relative;
    z-index: 2; /* This puts the entire nav above the overlay */
}

main .box{
    top:0;
    opacity:0.44;
    background-color: black;
 
}

nav .Netflix{
    color: rgb(255, 14, 14);
    font-size: 25px;
    padding: 10px 0 0 50px;
    display: flex;
  
}

.main .overlay{
    background-color: rgba(0, 0, 0, 0.8);
    z-index: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;

}

nav .line {
    color: white;
    position: relative; 
    font-weight: bold;
    font-size:x-large;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: 2px;  
    padding-top: 200px;
}

nav .line h5 {
    padding-top: 5px;
    font-weight: normal
}

nav .LINE h3{
    
    padding-top: 30px;
    font-weight: normal;
    color: white;
    padding-left: 400px;
    font-size: 140%;
}

nav .INPUT{
    padding-left: 404px;
    padding-top: 20px;
}

nav .INPUT input{
    height: 63px;
    width: 370px;
    border: 2px solid rgb(95, 92, 92);
    background-color: rgba(63, 63, 63, 0.5);
    padding-left: 15px;
    padding-right: 15px;  
    font-size: 19px;   
}

nav .INPUT input::placeholder {
    color: rgba(255, 255, 255, 0.7); 
}

nav .BUTTON{
    position: relative; /* Makes this the reference point */
}

nav .BUTTON button{
    color: white;
    background-color: rgb(238, 15, 15);
    height: 67px;
    width: 218px;
    position: absolute;
    top: -65px;
    left: 818px; 
    cursor: pointer;
    border-radius: 7px;
    font-size: 20px;
    padding-right: 70px;
}

