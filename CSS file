*{
    padding: 0px;
    margin: 0;
}
.main{
    background-image: url(assets/pictures/background.jpg);
    height: 100vh;
    position: relative;

}

nav {
    position: relative;
    z-index: 2; /* This puts the entire nav above the overlay */
}

main .box{
    top:0;
    opacity:0.44;
    background-color: black;
 
}

nav .Netflix{
    color: rgb(255, 14, 14);
    font-size: 25px;
    padding: 10px 0 0 50px;
    display: flex;
  
}

.main .overlay{
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;

}

nav .line {
    color: white;
    position: relative; 
    font-weight: bold;
    font-size:x-large;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: 2px;  
    padding-top: 200px;
}

nav .line h5 {
    margin-left: 2px;  
    padding-top: 5px;
    font-weight: normal
}

nav .LINE h3{
    margin-left: 2px;  
    padding-top: 30px;
    font-weight: normal;
    color: white;
    padding-left: 450px;
}
