*{
    padding: 0px;
    margin: 0;
}
.main{
    background-image: url(assets/pictures/background.jpg);
    height: 100vh;
    position: relative;

}

nav {
    position: relative;
    z-index: 2; /* This puts the entire nav above the overlay */
}

main .box{
    top:0;
    opacity:0.44;
    background-color: black;
 
}

nav .Netflix{
    color: rgb(255, 14, 14);
    font-size: 25px;
    padding: 10px 0 0 50px;
    display: flex;
  
}

.main .overlay{
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;

}

nav .line {
    color: white;
    position: relative; 
    font-weight: bold;
    font-size: larger;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

nav .line h1:nth-child(2) {
    margin-left: 2px;  
}
