<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netflix Clone</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="main">
        <div class="overlay"></div>
        <nav>
            <div class="Netflix">
                <h1>NETFLIX</h1>
                <div class="SignInButton">
                    <button>Sign In</button>
                </div>
            </div>
            
            <div class="line">
                <h1>Unlimited movies, TV </h1>
                <h1>shows, and more</h1>
                <h5>Starts at Rs 250. Cancel anytime.</h5>
            </div>
            <div class="LINE">
                <h5>Ready to watch? Enter your email to create or restart your membership.</h5>
            </div>
            <div class="INPUT">
                <input type="text" placeholder="Email address">
            </div>
            <div class="BUTTON">
                <button>Get Started</button>
            </div>
        </nav>
        
        <!-- Curved gradient line -->
<svg class="curved-line" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 40" preserveAspectRatio="none">
    <defs>
        <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:rgba(229, 9, 20, 0);stop-opacity:0" />
            <stop offset="15%" style="stop-color:rgba(229, 9, 20, 0.6);stop-opacity:1" />
            <stop offset="50%" style="stop-color:rgba(229, 9, 20, 1);stop-opacity:1" />
            <stop offset="85%" style="stop-color:rgba(229, 9, 20, 0.6);stop-opacity:1" />
            <stop offset="100%" style="stop-color:rgba(229, 9, 20, 0);stop-opacity:0" />
        </linearGradient>
    </defs>
    <path d="M0,20 Q720,3 1440,20" stroke="url(#gradient)" stroke-width="4" fill="none"/>
</svg>
    </div>
</body>
</html>
